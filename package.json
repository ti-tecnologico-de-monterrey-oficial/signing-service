{
  "name": "signing-service",
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "start": "node -r dotenv/config server.js",
    "dev": "nodemon -r dotenv/config server.js",
    "dev-noenv": "nodemon server.js",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "test-no-coverage": "vitest run",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "coveralls": "npm run test:coverage && coveralls < coverage/lcov.info",
    "prepare": "test -d node_modules/husky && husky install || echo \"husky is not installed\"",
    "test:health": "node -r dotenv/config healthcheck.js dotenv_config_path=./.env.healthcheck.testing "
  },
  "dependencies": {
    "@digitalbazaar/data-integrity": "^2.5.0",
    "@digitalbazaar/did-method-key": "^5.2.0",
    "@digitalbazaar/did-method-web": "^1.0.1",
    "@digitalbazaar/ed25519-multikey": "^1.3.1",
    "@digitalbazaar/ed25519-signature-2020": "^5.4.0",
    "@digitalbazaar/ed25519-verification-key-2020": "^4.2.0",
    "@digitalbazaar/eddsa-rdfc-2022-cryptosuite": "^1.2.0",
    "@digitalbazaar/vc": "^7.2.0",
    "@digitalcredentials/security-document-loader": "^8.0.0",
    "axios": "^1.11.0",
    "bnid": "^3.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "~5.1.0",
    "morgan": "~1.10.1",
    "nodemailer": "^7.0.5",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "chai": "^5.2.1",
    "coveralls": "^3.1.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "globals": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "nock": "^14.0.6",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "@vitest/coverage-v8": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
