{
  "name": "signing-service",
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "dev-noenv": "node --watch server.js",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "test-no-coverage": "vitest run",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky || true",
    "test:health": "node --env-file=.env.healthcheck.testing healthcheck.js"
  },
  "dependencies": {
    "@digitalbazaar/data-integrity": "^2.5.0",
    "@digitalbazaar/did-method-key": "^5.3.0",
    "@digitalbazaar/did-method-web": "^1.0.1",
    "@digitalbazaar/ed25519-multikey": "^1.3.1",
    "@digitalbazaar/ed25519-signature-2020": "^5.4.0",
    "@digitalbazaar/ed25519-verification-key-2020": "^4.2.0",
    "@digitalbazaar/eddsa-rdfc-2022-cryptosuite": "^1.3.0",
    "@digitalbazaar/vc": "^7.3.0",
    "@digitalcredentials/security-document-loader": "^9.0.0",
    "axios": "^1.20.0",
    "bnid": "^3.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "morgan": "^1.12.1",
    "nodemailer": "^10.2.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@digitalcredentials/ed25519-verification-key-2020": {
      "@stablelib/ed25519": "^2.1.0"
    }
  }
}
